{
  "name": "artseek",
  "version": "0.1.0",
  "description": "Root, zero-injection, read-only Android ART heap & View inspector SDK",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/std-microblock/artseek.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/std-microblock/artseek#readme",
  "bugs": {
    "url": "https://github.com/std-microblock/artseek/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "artseek": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "android",
    "art",
    "heap",
    "inspector",
    "view-hierarchy",
    "adb",
    "zero-injection"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
